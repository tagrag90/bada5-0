generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id
  username     String   @unique
  displayName  String
  email        String?  @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  bio          String?
  skills       String[] @default([])
  createdAt    DateTime @default(now())

  // 기존 관계
  bookmarks             Bookmark[]
  comments              Comment[]
  following             Follow[]       @relation("Following")
  followers             Follow[]       @relation("Followers")
  likes                 Like[]
  issuedNotifications   Notification[] @relation("Issuer")
  receivedNotifications Notification[] @relation("Recipient")
  posts                 Post[]
  sessions              Session[]

  // Studio 관계
  ownedStudios        Studio[]             @relation("OwnedStudios")
  studioMemberships   StudioMember[]
  studioSubscriptions StudioSubscription[]
  tickets             Ticket[]
  studioItems         StudioItem[]
  projectNodes        ProjectNode[]
  workspaceFiles      WorkspaceFile[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String         @id @default(cuid())
  title               String?
  content             String
  userId              String
  studioId            String?
  createdAt           DateTime       @default(now())
  linkPreviews        Json?
  bookmarks           Bookmark[]
  comments            Comment[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studio              Studio?        @relation("StudioPosts", fields: [studioId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id])

  @@map("post_media")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
}

// ============= Studio System Models =============

model Studio {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  type        StudioType @default(PERSONAL)

  ownerId String
  owner   User   @relation("OwnedStudios", fields: [ownerId], references: [id], onDelete: Cascade)

  avatarUrl   String?
  bannerUrl   String?
  socialLinks String[] @default([])
  isPublic    Boolean  @default(true)
  isVerified  Boolean  @default(false)

  subscribersCount Int  @default(0)
  order            Int? // 드래그 정렬 순서

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       StudioMember[]
  subscriptions StudioSubscription[]
  events        Event[]
  items         StudioItem[]
  posts         Post[]               @relation("StudioPosts")
  nodes         ProjectNode[]
  edges         NodeEdge[]
  files         WorkspaceFile[]

  @@map("studios")
}

model StudioMember {
  id       String     @id @default(cuid())
  studioId String
  userId   String
  role     StudioRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId])
  @@map("studio_members")
}

model StudioSubscription {
  id           String   @id @default(cuid())
  studioId     String
  userId       String
  subscribedAt DateTime @default(now())

  studio Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId])
  @@map("studio_subscriptions")
}

enum StudioType {
  PERSONAL
  TEAM
}

enum StudioRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

// ============= Ticketing System Models =============

model Event {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  title       String
  description String?
  slug        String   @unique
  location    String?
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?

  status    EventStatus @default(DRAFT)
  isPublic  Boolean     @default(true)
  viewCount Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticketTypes TicketType[]
  tickets     Ticket[]

  @@map("events")
}

model TicketType {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name        String
  description String?
  totalCount  Int
  issuedCount Int     @default(0)
  price       Int     @default(0)
  color       String?

  tickets Ticket[]

  @@map("ticket_types")
}

model Ticket {
  id      String @id @default(cuid())
  eventId String
  typeId  String
  userId  String

  qrCode      String @unique
  qrSignature String

  status TicketStatus @default(VALID)

  issuedAt    DateTime  @default(now())
  usedAt      DateTime?
  checkedInBy String?

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type  TicketType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  ENDED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  EXPIRED
}

// ============= Studio Unified Item System (Notion-style) =============

model StudioItem {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // 공통 필드
  title   String
  content String
  type    StudioItemType @default(NOTE)

  // 선택적 필드 (타입에 따라 사용)
  date      DateTime?
  time      String?
  duration  String?
  location  String?
  attendees String[]  @default([])
  tags      String[]  @default([])

  // 메타데이터
  isPinned Boolean @default(false)
  category String?
  color    String?

  // 작성자
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("studio_items")
}

enum StudioItemType {
  NOTE // 메모
  EVENT // 일정/이벤트
  TASK // 할 일 (추후 확장)
}

// ============= Workspace Node System Models =============

model ProjectNode {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  // 노드 위치 및 크기
  x      Float
  y      Float
  width  Float @default(300)
  height Float @default(200)

  // 노드 타입 및 실행 가능 여부
  type    NodeType
  title   String
  content String? // JSON (데이터 또는 설정)

  // 실행 관련 필드 (SDK/자동화용 - Phase 3+)
  isExecutable  Boolean        @default(false) // 실행 가능한 노드인지
  executionType ExecutionType? // CODE, WORKFLOW, SDK_PLUGIN
  codeFileUrl   String? // AI 생성 코드 파일 URL (Vercel Blob)
  codeLanguage  String? // js, ts, python 등
  pluginId      String? // SDK 플러그인 ID

  // 입출력 포트 정의 (스크래치/블록 코딩 스타일 - Phase 2+)
  inputPorts  Json? // [{ id, name, type, required }]
  outputPorts Json? // [{ id, name, type }]

  // 노드 상태 및 실행 (Phase 3+)
  status              NodeStatus @default(IDLE) // IDLE, RUNNING, SUCCESS, ERROR
  lastExecutionResult Json? // 마지막 실행 결과
  lastExecutedAt      DateTime?

  // 연결 관계
  fromEdges NodeEdge[] @relation("FromNode")
  toEdges   NodeEdge[] @relation("ToNode")

  // 워크스페이스 파일 관계 (nullable로 시작하여 기존 데이터 보존)
  fileId String?
  file   WorkspaceFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // 메타데이터
  emoji       String? // 노션 스타일 이모지 (타이틀 앞에 표시)
  color       String?
  isCollapsed Boolean @default(false)
  config      Json? // 노드별 설정 (UI 설정 등)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_nodes")
}

model NodeEdge {
  id       String      @id @default(cuid())
  studioId String
  studio   Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  fromId   String
  fromNode ProjectNode @relation("FromNode", fields: [fromId], references: [id], onDelete: Cascade)
  toId     String
  toNode   ProjectNode @relation("ToNode", fields: [toId], references: [id], onDelete: Cascade)

  // 워크스페이스 파일 관계 (nullable로 시작하여 기존 데이터 보존)
  fileId String?
  file   WorkspaceFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // 데이터 흐름 정의 (Phase 2+)
  fromPort String? // 연결 시작 포트 ID
  toPort   String? // 연결 끝 포트 ID

  type  EdgeType @default(ARROW)
  label String?
  color String?

  createdAt DateTime @default(now())

  @@unique([fromId, toId, fromPort, toPort]) // 같은 포트 중복 연결 방지
  @@map("node_edges")
}

enum NodeType {
  // 기본 노드 타입 (Phase 1)
  PLANNING // 기획
  NOTE // 메모
  SCHEDULE // 일정관리/캘린더
  RESOURCE // 자료공유
  POST // 게시물
  PHOTO // 사진

  // 자동화 노드 타입 (Phase 3+)
  TRIGGER // 트리거 노드 (시작점)
  ACTION // 액션 노드 (실행)
  CONDITION // 조건 노드 (if/else)
  LOOP // 반복 노드
  TRANSFORM // 데이터 변환 노드

  // SDK 커스텀 타입 (Phase 4+)
  CUSTOM // SDK 플러그인으로 만들어진 노드
}

enum ExecutionType {
  CODE // 직접 코드 실행
  WORKFLOW // 워크플로우 실행
  SDK_PLUGIN // SDK 플러그인 실행
}

enum NodeStatus {
  IDLE // 대기
  RUNNING // 실행 중
  SUCCESS // 성공
  ERROR // 에러
}

enum EdgeType {
  ARROW // 화살표 (기본)
  DASHED // 점선
  DOTTED // 점점선
}

// ============= Workspace File System Models =============

model WorkspaceFile {
  id       String @id @default(cuid())
  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  name         String
  description  String?
  thumbnailUrl String? // 썸네일 이미지 (선택)
  order        Int     @default(0) // 정렬 순서

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes ProjectNode[] // 각 파일은 고유한 노드 세트를 가짐
  edges NodeEdge[] // 각 파일은 고유한 연결선 세트를 가짐

  @@map("workspace_files")
}
