generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id                    String                 @id
  username              String                 @unique
  displayName           String
  email                 String?                @unique
  passwordHash          String?
  googleId              String?                @unique
  avatarUrl             String?
  bio                   String?
  skills                String[]               @default([])
  createdAt             DateTime               @default(now())
  
  // 기존 관계
  board_members         board_members[]
  boards                boards[]
  bookmarks             Bookmark[]
  cards                 cards[]
  comments              Comment[]
  following             Follow[]               @relation("Following")
  followers             Follow[]               @relation("Followers")
  likes                 Like[]
  issuedNotifications   Notification[]         @relation("Issuer")
  receivedNotifications Notification[]         @relation("Recipient")
  posts                 Post[]
  sessions              Session[]
  
  // Studio 관계
  ownedStudios          Studio[]               @relation("OwnedStudios")
  studioMemberships     StudioMember[]
  studioSubscriptions   StudioSubscription[]
  tickets               Ticket[]
  studioItems           StudioItem[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Post {
  id                  String         @id @default(cuid())
  title               String?
  content             String
  userId              String
  createdAt           DateTime       @default(now())
  linkPreviews        Json?
  bookmarks           Bookmark[]
  comments            Comment[]
  likes               Like[]
  linkedNotifications Notification[]
  attachments         Media[]
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Media {
  id        String    @id @default(cuid())
  postId    String?
  type      MediaType
  url       String
  createdAt DateTime  @default(now())
  post      Post?     @relation(fields: [postId], references: [id])

  @@map("post_media")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Like {
  userId String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("bookmarks")
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  issuerId    String
  postId      String?
  type        NotificationType
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model board_members {
  id       String    @id
  boardId  String
  userId   String
  role     BoardRole @default(MEMBER)
  joinedAt DateTime  @default(now())
  boards   boards    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  users    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model boards {
  id            String          @id
  title         String
  description   String?
  ownerId       String
  isPublic      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  board_members board_members[]
  users         User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lists         lists[]
}

model cards {
  id          String    @id
  title       String
  description String?
  position    Int
  listId      String
  assigneeId  String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  users       User?     @relation(fields: [assigneeId], references: [id])
  lists       lists     @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model lists {
  id        String   @id
  title     String
  position  Int
  boardId   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  cards     cards[]
  boards    boards   @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationType {
  LIKE
  FOLLOW
  COMMENT
}

enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ============= Studio System Models =============

model Studio {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  description      String?
  type             StudioType           @default(PERSONAL)
  
  ownerId          String
  owner            User                 @relation("OwnedStudios", fields: [ownerId], references: [id], onDelete: Cascade)
  
  avatarUrl        String?
  bannerUrl        String?
  isPublic         Boolean              @default(true)
  isVerified       Boolean              @default(false)
  
  subscribersCount Int                  @default(0)
  
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  
  members          StudioMember[]
  subscriptions    StudioSubscription[]
  events           Event[]
  items            StudioItem[]
  
  @@map("studios")
}

model StudioMember {
  id        String      @id @default(cuid())
  studioId  String
  userId    String
  role      StudioRole  @default(MEMBER)
  joinedAt  DateTime    @default(now())
  
  studio    Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([studioId, userId])
  @@map("studio_members")
}

model StudioSubscription {
  id           String   @id @default(cuid())
  studioId     String
  userId       String
  subscribedAt DateTime @default(now())
  
  studio       Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([studioId, userId])
  @@map("studio_subscriptions")
}

enum StudioType {
  PERSONAL
  TEAM
}

enum StudioRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

// ============= Ticketing System Models =============

model Event {
  id          String      @id @default(cuid())
  studioId    String
  studio      Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  slug        String      @unique
  location    String?
  startDate   DateTime
  endDate     DateTime
  imageUrl    String?
  
  status      EventStatus @default(DRAFT)
  isPublic    Boolean     @default(true)
  viewCount   Int         @default(0)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  ticketTypes TicketType[]
  tickets     Ticket[]
  
  @@map("events")
}

model TicketType {
  id          String  @id @default(cuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  totalCount  Int
  issuedCount Int     @default(0)
  price       Int     @default(0)
  color       String?
  
  tickets     Ticket[]
  
  @@map("ticket_types")
}

model Ticket {
  id          String       @id @default(cuid())
  eventId     String
  typeId      String
  userId      String
  
  qrCode      String       @unique
  qrSignature String
  
  status      TicketStatus @default(VALID)
  
  issuedAt    DateTime     @default(now())
  usedAt      DateTime?
  checkedInBy String?
  
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        TicketType   @relation(fields: [typeId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("tickets")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  ENDED
  CANCELLED
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  EXPIRED
}

// ============= Studio Unified Item System (Notion-style) =============

model StudioItem {
  id          String       @id @default(cuid())
  studioId    String
  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  
  // 공통 필드
  title       String
  content     String
  type        StudioItemType @default(NOTE)
  
  // 선택적 필드 (타입에 따라 사용)
  date        DateTime?
  time        String?
  duration    String?
  location    String?
  attendees   String[]     @default([])
  tags        String[]     @default([])
  
  // 메타데이터
  isPinned    Boolean      @default(false)
  category    String?
  color       String?
  
  // 작성자
  authorId    String
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@map("studio_items")
}

enum StudioItemType {
  NOTE      // 메모
  EVENT     // 일정/이벤트
  TASK      // 할 일 (추후 확장)
}
